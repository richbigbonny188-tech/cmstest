a:441:{s:20:"ADMIN_LINK_INFO_TEXT";s:92:"Klicken Sie auf Abbrechen, wenn Sie diesen Link nicht aufrufen, sondern bearbeiten möchten.";s:18:"AT_LEAST_ONE_INPUT";s:130:"Eines der folgenden Felder muss ausgefüllt werden:<br />Stichworte mit mindestens drei Zeichen<br />Preis ab<br />Preis bis<br />";s:19:"BOX_ENTRY_CUSTOMERS";s:6:"Kunden";s:18:"BOX_ENTRY_PRODUCTS";s:7:"Artikel";s:17:"BOX_ENTRY_REVIEWS";s:11:"Bewertungen";s:26:"BOX_HEADING_ADD_PRODUCT_ID";s:17:"In den Korb legen";s:21:"BOX_LOGINBOX_DISCOUNT";s:13:"Artikelrabatt";s:24:"BOX_LOGINBOX_DISCOUNT_OT";s:0:"";s:26:"BOX_LOGINBOX_DISCOUNT_TEXT";s:6:"Rabatt";s:19:"BOX_LOGINBOX_STATUS";s:14:"Kundengruppe: ";s:30:"BOX_MANUFACTURER_INFO_HOMEPAGE";s:11:"%s Homepage";s:36:"BOX_MANUFACTURER_INFO_OTHER_PRODUCTS";s:12:"Mehr Artikel";s:27:"BOX_REVIEWS_TEXT_OF_5_STARS";s:17:"%s von 5 Sternen!";s:24:"BOX_REVIEWS_WRITE_REVIEW";s:28:"Bewerten Sie diesen Artikel!";s:20:"BOX_TITLE_STATISTICS";s:10:"Statistik:";s:6:"CANCEL";s:9:"Abbrechen";s:20:"CART_WISHLIST_DELETE";s:55:"Wollen Sie den Artikel wirklich aus der Liste löschen?";s:26:"CART_WISHLIST_DELETE_TITLE";s:17:"Artikel löschen?";s:20:"CART_WISHLIST_REFUSE";s:47:"Wollen Sie die gemachten Änderungen verwerfen?";s:26:"CART_WISHLIST_REFUSE_TITLE";s:22:"Änderungen verwerfen?";s:15:"CATEGORIES_NEXT";s:7:"Weitere";s:19:"CATEGORIE_NOT_FOUND";s:30:"Kategorie wurde nicht gefunden";s:5:"CLOSE";s:10:"Schließen";s:30:"COUPON_NOT_APPLIED_TO_VOUCHERS";s:61:"Der Coupon hat keine Auswirkung auf den Preis von Gutscheinen";s:14:"CREATE_ACCOUNT";s:25:"Ein Kundenkonto erstellen";s:21:"CUSTOMER_UPLOAD_ERROR";s:7:"Error! ";s:35:"CUSTOMER_UPLOAD_ERROR_FILE_REQUIRED";s:13:"Choose a File";s:36:"CUSTOMER_UPLOAD_ERROR_WRONG_FILE_TYP";s:19:"Allowed Filetypes: ";s:21:"EMAIL_GV_TEXT_SUBJECT";s:19:"Ein Geschenk von %s";s:14:"ENTER_CATEGORY";s:11:"%s anzeigen";s:19:"ENTRY_CHECK_PRIVACY";s:136:"Die <a href="%s" target="_blank" class="lightbox_iframe">Datenschutzbestimmungen</a> habe ich zur Kenntnis genommen