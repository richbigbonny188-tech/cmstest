:"Bewertungen";s:21:"review_collector_info";s:81:"Bestellungen für die Übergabe an den Trusted Shops Review Collector exportieren";s:22:"review_sticker_snippet";s:19:"Review Sticker Code";s:12:"SHOWHIDEINFO";s:23:"Info anzeigen/verbergen";s:8:"TH_APPNO";s:13:"Antragsnummer";s:11:"TH_CUSTOMER";s:5:"Kunde";s:7:"TH_DATE";s:5:"Datum";s:13:"TH_FOR_RATING";s:14:"für Bewertung";s:14:"TH_GUARANTEENO";s:21:"Status/Garantienummer";s:11:"TH_LANGUAGE";s:7:"Sprache";s:8:"TH_ORDER";s:10:"Bestellung";s:8:"TH_STATE";s:6:"Status";s:8:"TH_TS_ID";s:16:"Trusted-Shops-ID";s:7:"TH_TYPE";s:3:"Typ";s:6:"TH_URL";s:3:"URL";s:27:"trustbadge_integration_info";s:105:"In unserem Integration Center finden Sie eine Schritt-für-Schritt Anleitung passend zu Ihrem Shopsystem.";s:38:"trustbadge_integration_info_click_here";s:17:"Klicken Sie hier.";s:16:"TS_BADGE_VARIANT";s:8:"Variante";s:24:"TS_BADGE_VARIANT_DEFAULT";s:8:"Standard";s:24:"TS_BADGE_VARIANT_REVIEWS";s:7:"Reviews";s:22:"TS_BADGE_VARIANT_SMALL";s:5:"klein";s:21:"TS_BADGE_VARIANT_TEXT";s:4:"Text";s:16:"TS_BADGE_YOFFSET";s:25:"Abstand von unterer Kante";s:18:"TS_BP_APPLICATIONS";s:43:"Anträge auf Käuferschutz (letzte 30 Tage)";s:14:"TS_CHECKALLIDS";s:21:"alle IDs überprüfen";s:12:"TS_CHECKSAVE";s:17:"prüfen/speichern";s:14:"TS_CHECKUPDATE";s:21:"abrufen/aktualisieren";s:14:"TS_CRONJOB_URL";s:12:"Cronjob-URL:";s:9:"TS_DELETE";s:8:"löschen";s:12:"TS_DOUBLE_ID";s:52:"Für diese Sprache und URL liegt bereits eine ID vor";s:15:"TS_ENABLE_BADGE";s:21:"Trustbadge aktivieren";s:16:"TS_ENABLE_MODULE";s:16:"Modul aktivieren";s:24:"TS_ENABLE_review_sticker";s:25:"Review Sticker aktivieren";s:23:"TS_ENABLE_RICH_SNIPPETS";s:23:"Rich Snippets verwenden";s:34:"TS_ENABLE_RICH_SNIPPETS_CATEGORIES";s:42:"Rich Snippets aktivieren (Kategorieseiten)";s:29:"TS_ENABLE_RICH_SNIPPETS_OTHER";s:57:"Rich Snippets aktivieren (andere Seiten; nicht empfohlen)";s:32:"TS_ENABLE_RICH_SNIPPETS_PRODUCTS";s:40:"Rich Snippets aktivieren (Artikelseiten)";s:14:"TS_ENABLE_SEAL";s:37:"Box mit Trusted-Shops-Siegel anzeigen";s:22:"TS_HEADING_INTEGRATION";s:31:"Allgemeine Integrationsoptionen";s:17:"TS_HEADING_RATING";s:15:"Kundenbewertung";s:24:"TS_HEADING_REVIEWSTICKER";s:14:"Review Sticker";s:21:"TS_HEADING_TRUSTBADGE";s:10:"Trustbadge";s:13:"ts_id_deleted";s:14:"TSID gelöscht";s:27:"ts_id_specific_settings_for";s:39:"Einstellungen für die Trusted-Shops-ID";s:16:"TS_INFO_TEXTHEAD";s:412:"<p style="font-size:14px;"><strong>Gütesiegel mit Käuferschutz</strong></p><p>Trusted Shops ist das bekannte Internet-Gütesiegel für Online-Shops mit Käuferschutz für Ihre Kunden. Bei einer Zertifizierung wird Ihr Shop umfassenden Tests unterzogen. Diese Prüfung mit mehr als 70 Einzelkriterien orientiert sich an den Forderungen von Verbraucherschützern sowie dem nationalen und europäischen Recht.</p>";s:16:"TS_INFO_TEXTLINK";s:25:"Informieren und anmelden!";s:16:"TS_INFO_TEXTMID1";s:221:"<strong>Mehr Umsatz durch mehr Vertrauen!</strong><br />Das Trusted Shops Gütesiegel ist optimal, um das Vertrauen Ihrer Online-Kunden zu steigern. Vertrauen steigert die Bereitschaft Ihrer Kunden, bei Ihnen einzukaufen.";s:16:"TS_INFO_TEXTMID2";s:203:"<strong>Weniger Kaufabbrüche</strong><br />Sie bieten Ihren Online-Kunden ein starkes Argument: den Trusted Shops Käuferschutz. Durch diese zusätzliche Sicherheit werden weniger Einkäufe abgebrochen.";s:16:"TS_INFO_TEXTMID3";s:355:"<strong>Ihre Kunden werden zu Verkäufern</strong><br />Nutzen Sie unsere Händlerbewertung mit integrierten Kundenmeinungen als wichtiges Marketing-Tool, um das Vertrauen Ihrer Kunden zu steigern. Lassen Sie Ihre gute Bewertung bei Google Shopping anzeigen und erhöhen Sie Ihren Traffic.<br /><br />Nutzen Sie die Sonderkonditionen speziell für Gambio!";s:20:"TS_INFO_TEXTPREPARED";s:63:"Gambio ist bereits optimal für die Zertifizierung vorbereitet!";s:11:"TS_INFO_URL";s:105:"http://www.trustedshops.de/shopbetreiber/mitgliedschaft_partner.html?shopsw=GAMBIO&et_cid=14&et_lid=58032";s:13:"TS_INVALID_ID";s:13:"Ungültige ID";s:16:"TS_LOGIN_INVALID";s:22:"Zugangsdaten ungültig";s:11:"TS_PASSWORD";s:9:"Passwort:";s:13:"TS_PROCESSING";s:14:"in Bearbeitung";s:7:"TS_SAVE";s:9:"speichern";s:24:"TS_SHOW_RATING_COSUCCESS";s:56:"Bewertungs-Button auf Bestellbestätigungsseite anzeigen";s:20:"TS_SHOW_RATING_EMAIL";s:57:"Bewertungs-Button in Bestellbestätigungs-E-Mail anzeigen";s:11:"TS_USERNAME";s:13:"Benutzername:";s:15:"TS_YES_ACTIVATE";s:14:"ja, aktivieren";s:23:"username_for_excellence";s:12:"Benutzername";s:18:"use_for_excellence";s:35:"Excellence-Käuferschutz aktivieren";s:22:"yes_use_for_excellence";s:14:"ja, aktivieren";}