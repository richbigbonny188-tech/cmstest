a:4:{s:9:"text_copy";s:8:"Kopieren";s:11:"text_notice";s:46:"Der Link wurde in Ihre Zwischenablage kopiert!";s:12:"text_warning";s:150:"Der Link konnte nicht in die Zwischenablage kopiert werden. Bitte kopiere den Text manuell mit der Tastenkombination STRG + C, bzw. CMD + C für Macs.";s:5:"title";s:16:"Warenkorb teilen";}