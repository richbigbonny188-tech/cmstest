a:13:{s:13:"heading_login";s:18:"Melden Sie sich an";s:10:"text_email";s:15:"E-Mail-Adresse:";s:10:"text_guest";s:169:"Durch Ihre Bestellung als Gast wird kein eigenes Kundenkonto für Sie angelegt. Dies bedeutet, dass Sie bei einer erneuten Bestellung alle Daten erneut eingeben müssen.";s:18:"text_lost_password";s:19:"Passwort vergessen?";s:8:"text_new";s:119:"Legen Sie ein Kundenkonto an, um schneller bestellen zu können und jederzeit den Status Ihrer Bestellung zu verfolgen.";s:21:"text_new_account_only";s:179:"Wenn Sie noch kein Kundenkonto besitzen, können Sie hier eines anlegen. Sie können sich damit in Zukunft schnell einloggen und jederzeit den Status Ihrer Bestellungen verfolgen.";s:19:"text_new_guest_only";s:73:"Bitte geben Sie Ihre Kundendaten ein, um mit der Bestellung fortzufahren.";s:21:"text_new_guest_option";s:67:"Sie können auch ohne dauerhafte Registrierung als Gast fortfahren.";s:13:"text_password";s:9:"Passwort:";s:14:"text_returning";s:0:"";s:11:"title_guest";s:18:"Als Gast bestellen";s:9:"title_new";s:23:"Ich bin ein neuer Kunde";s:15:"title_returning";s:21:"Ich bin bereits Kunde";}