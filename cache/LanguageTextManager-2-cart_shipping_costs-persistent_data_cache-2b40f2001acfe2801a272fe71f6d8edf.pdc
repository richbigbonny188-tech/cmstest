a:9:{s:17:"combi_not_allowed";s:67:"Diese Kombination aus Lieferland und Versandart ist nicht möglich.";s:8:"delivery";s:7:"Versand";s:16:"delivery_country";s:10:"Lieferland";s:28:"no_shipping_module_available";s:23:"Kein Versand verfügbar";s:14:"shipping_costs";s:13:"Versandkosten";s:26:"shipping_costs_calculating";s:23:"Versandkostenberechnung";s:15:"shipping_module";s:10:"Versandart";s:2:"to";s:4:"nach";s:12:"tooltip_info";s:544:"Die Berechnung der angezeigten Versandkosten erfolgt unter der Annahme von "<span class="cart_shipping_costs_country_name" title="%s">%s</span>" als Lieferland, sowie "<span class="cart_shipping_costs_module_name" title="%s">%s</span>" als Versandart. Die tatsächlichen Versandkosten können je nach gewähltem Lieferland und Versandart variieren. Das gewünschte Lieferland und die Versandart können im <a href="%s">Warenkorb</a> gewählt werden. Die tatsächlichen Versandkosten werden dann auf Basis dieser Angaben berechnet und angezeigt.";}